{
  "name": "tide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev -p 8776",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p 8776",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm run lint && npm run test:coverage",
    "db:generate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js generate",
    "db:deploy": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "db:backup": "node --env-file-if-exists=.env --import tsx scripts/backup.ts",
    "docker:build": "node scripts/docker.mjs build",
    "docker:tag": "node scripts/docker.mjs tag",
    "docker:test": "node scripts/docker.mjs test",
    "docker:push": "node scripts/docker.mjs push",
    "docs:check": "node scripts/check-docs.mjs",
    "format": "prettier --write src scripts tests .storybook .github --ignore-path .prettierignore *.ts *.mjs",
    "format:check": "prettier --check src scripts tests .storybook .github --ignore-path .prettierignore *.ts *.mjs",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build --disable-telemetry",
    "test:stories": "vitest run --config vitest.storybook.config.ts",
    "test:stories:coverage": "vitest run --config vitest.storybook.config.ts --coverage",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource/ibm-plex-sans": "5.2.8",
    "@fullcalendar/daygrid": "6.1.20",
    "@fullcalendar/interaction": "6.1.20",
    "@fullcalendar/luxon3": "6.1.20",
    "@fullcalendar/react": "6.1.20",
    "@fullcalendar/timegrid": "6.1.20",
    "@js-temporal/polyfill": "0.5.1",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dialog": "1.1.15",
    "@tanstack/react-query": "5.90.21",
    "@tiptap/extension-placeholder": "3.20.4",
    "@tiptap/react": "3.20.4",
    "@tiptap/starter-kit": "3.20.4",
    "archiver": "7.0.1",
    "better-sqlite3": "12.9.0",
    "lucide-react": "0.577.0",
    "luxon": "3.7.2",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rrule": "2.8.1",
    "unzipper": "0.12.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.59.1",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/nextjs-vite": "10.6.3",
    "@types/archiver": "7.0.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/unzipper": "0.10.11",
    "@vitest/browser-playwright": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.3",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "storybook": "10.6.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "msw": {
    "workerDirectory": [
      ".storybook/public"
    ]
  }
}
